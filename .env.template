# Conky Themes Configuration - API Credentials
# ============================================
# REQUIRED: Last.fm API
# Get your API key from: https://www.last.fm/api/account/create

LASTFM_API_KEY=""
LASTFM_USERNAME=""

# ============================================
# OPTIONAL: OpenWeatherMap API
# Get free API key at: https://openweathermap.org/api

WEATHER_API_KEY=""
# Location detection. Leave unset to auto-detect from geo-IP, which picks up
# your real city. Set a city name to pin it - worth doing when your ISP routes
# through a regional hub and reports the wrong town:
#WEATHER_NAME="Narok"
#
# Or pin exact coordinates, which skips both geo-IP and geocoding:
#WEATHER_LAT="-1.2921"
#WEATHER_LON="36.8219"
#
# WEATHER_CITY is still read as a fallback alias for older configs.

# ============================================
# FreeNewsApi.io API
# Get your free API key at: https://newsapi.org/register

NEWS_API_KEY=""
